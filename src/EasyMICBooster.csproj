<Project>
  <Import Project="..\build\Directory.Build.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>EasyMICBooster</AssemblyName>
    <RootNamespace>EasyMICBooster</RootNamespace>
    <StartupObject>EasyMICBooster.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Read version from version.txt in project root -->
    <AppVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\version.txt').Trim())</AppVersion>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <FileVersion>$(AppVersion).0</FileVersion>
    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Lang\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="..\version.txt">
      <Link>version.txt</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LICENSE">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\THIRD-PARTY-NOTICES.txt">
      <Link>THIRD-PARTY-NOTICES.txt</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Resource Include="Resources\App.ico" />
  </ItemGroup>

  <!--
    RNNoise native binary. Optional: if rnnoise.dll is missing, the app still runs
    and the AI Noise Suppression toggle is disabled at runtime. See
    native/runtimes/README.md for how to obtain or build the DLL.
  -->
  <ItemGroup>
    <Content Include="..\native\runtimes\win-x64\native\rnnoise.dll"
             Condition="(('$(RuntimeIdentifier)' == 'win-x64') OR ('$(RuntimeIdentifier)' == '')) AND Exists('..\native\runtimes\win-x64\native\rnnoise.dll')">
      <Link>rnnoise.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\native\runtimes\win-x86\native\rnnoise.dll"
             Condition="'$(RuntimeIdentifier)' == 'win-x86' AND Exists('..\native\runtimes\win-x86\native\rnnoise.dll')">
      <Link>rnnoise.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
